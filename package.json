<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OPPORTUNITY RADAR</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #0b1020;
  color: white;
}

header {
  background: #151d35;
  padding: 20px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  color: #a78bfa;
  font-size: 22px;
  font-weight: bold;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 15px;
}

nav a:hover {
  color: #a78bfa;
}

.hero {
  text-align: center;
  padding: 75px 20px;
  background: linear-gradient(135deg, #151d35, #312e81);
}

.hero h1 {
  font-size: 40px;
  color: #c4b5fd;
  margin-bottom: 18px;
}

.hero p {
  color: #e2e8f0;
  line-height: 1.7;
}

.search {
  margin-top: 25px;
}

.search input {
  width: 90%;
  max-width: 480px;
  padding: 15px;
  border: none;
  border-radius: 10px;
  font-size: 16px;
}

.container {
  max-width: 1100px;
  padding: 40px 20px;
  margin: auto;
}

.section-title {
  color: #c4b5fd;
  margin-bottom: 25px;
}

.cards {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.card {
  background: #192440;
  border: 1px solid #334155;
  border-radius: 15px;
  padding: 25px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: #a78bfa;
}

.card h3 {
  color: #c4b5fd;
  margin-bottom: 15px;
}

.card p {
  color: #cbd5e1;
  line-height: 1.6;
  margin-bottom: 18px;
}

button {
  background: #7c3aed;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px 18px;
  cursor: pointer;
}

button:hover {
  background: #6d28d9;
}

.stats {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(150px, 1fr));
  gap: 15px;
  margin-top: 35px;
}

.stat {
  background: #192440;
  padding: 22px;
  border-radius: 12px;
  text-align: center;
}

.stat h2 {
  color: #a78bfa;
  margin-bottom: 8px;
}

.stat p {
  color: #cbd5e1;
}

.about {
  background: #151d35;
  padding: 30px;
  border-radius: 15px;
  margin-top: 40px;
  line-height: 1.8;
}

.about h2 {
  color: #c4b5fd;
  margin-bottom: 12px;
}

.no-results {
  display: none;
  color: #fca5a5;
  margin-top: 20px;
}

footer {
  background: #151d35;
  text-align: center;
  padding: 25px;
  color: #94a3b8;
  margin-top: 40px;
  line-height: 1.8;
}

@media(max-width: 600px) {
  header {
    flex-direction: column;
  }

  nav a {
    margin: 8px;
  }

  .hero h1 {
    font-size: 30px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🚀 OPPORTUNITY RADAR</div>

  <nav>
    <a href="#home">Home</a>
    <a href="#explore">Explore</a>
    <a href="#about">About</a>
  </nav>
</header>

<section class="hero" id="home">

  <h1>Discover Your Next Opportunity</h1>

  <p>
    Find scholarships, internships, hackathons
    and competitions in one place.
  </p>

  <div class="search">
    <input
      type="text"
      id="searchInput"
      placeholder="🔍 Search opportunities..."
      oninput="searchOpportunities()"
    >
  </div>

</section>

<main class="container" id="explore">

  <h2 class="section-title">
    Explore Opportunities
  </h2>

  <div class="cards" id="cards">

    <div class="card">
      <h3>🎓 Scholarships</h3>
      <p>
        Discover educational funding opportunities
        and scholarship programs.
      </p>
      <button onclick="showInfo('Scholarships')">
        Explore Now
      </button>
    </div>

    <div class="card">
      <h3>💼 Internships</h3>
      <p>
        Find internships and gain professional
        experience and practical skills.
      </p>
      <button onclick="showInfo('Internships')">
        Explore Now
      </button>
    </div>

    <div class="card">
      <h3>🏆 Hackathons</h3>
      <p>
        Participate in hackathons and showcase
        your creative ideas.
      </p>
      <button onclick="showInfo('Hackathons')">
        Explore Now
      </button>
    </div>

    <div class="card">
      <h3>📚 Competitions</h3>
      <p>
        Discover competitions and challenges
        to improve your abilities.
      </p>
      <button onclick="showInfo('Competitions')">
        Explore Now
      </button>
    </div>

    <div class="card">
      <h3>🚀 Career Programs</h3>
      <p>
        Explore career development programs
        and learning opportunities.
      </p>
      <button onclick="showInfo('Career Programs')">
        Explore Now
      </button>
    </div>

    <div class="card">
      <h3>🤖 AI Recommendations</h3>
      <p>
        Discover opportunities based on
        your interests and goals.
      </p>
      <button onclick="showInfo('AI Recommendations')">
        Explore Now
      </button>
    </div>

  </div>

  <p class="no-results" id="noResults">
    No matching opportunities found.
  </p>

  <div class="stats">

    <div class="stat">
      <h2>6</h2>
      <p>Categories</p>
    </div>

    <div class="stat">
      <h2>24/7</h2>
      <p>Explore Anytime</p>
    </div>

    <div class="stat">
      <h2>100%</h2>
      <p>Student Focused</p>
    </div>

  </div>

  <section class="about" id="about">

    <h2>About OPPORTUNITY RADAR</h2>

    <p>
      OPPORTUNITY RADAR is a student-focused
      opportunity discovery platform designed
      to help students find scholarships,
      internships, hackathons and competitions
      from one convenient place.

      Our mission is to make opportunities
      easier to discover and help students
      achieve their career goals.
    </p>

  </section>

</main>

<footer>
  <p>© 2026 OPPORTUNITY RADAR</p>
  <p>Discover Opportunities. Build Your Future.</p>
  <p>Created for Students ❤️</p>
</footer>

<script>

function showInfo(category) {
  alert(
    "Welcome to " + category +
    "! Opportunity listings will be added soon."
  );
}

function searchOpportunities() {

  const input = document
    .getElementById("searchInput")
    .value.toLowerCase();

  const cards = document
    .querySelectorAll(".card");

  let visible = 0;

  cards.forEach(function(card) {

    const text = card.innerText.toLowerCase();

    if (text.includes(input)) {
      card.style.display = "block";
      visible++;
    } else {
      card.style.display = "none";
    }

  });

  document.getElementById("noResults")
    .style.display = visible === 0 ? "block" : "none";

}

</script>

</body>
</html>